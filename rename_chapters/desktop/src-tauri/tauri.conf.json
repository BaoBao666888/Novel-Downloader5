{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Novel Studio",
  "version": "0.1.0",
  "identifier": "io.github.baobao666888.novelstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Novel Studio",
        "width": 1160,
        "height": 780,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../icon.ico"]
  }
}
